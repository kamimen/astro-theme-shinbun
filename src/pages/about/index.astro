---
import { getEntry, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import config from "../../config.ts";
import { ja } from "../../i18n/ja.ts";

const entry = await getEntry("pages", "about");
const { Content } = entry ? await render(entry) : { Content: null };
---

<Layout title={ja.about} description={entry?.data.description} section={ja.about}>
  <main class="sb-page post-page">
    <article class="sb-article post" data-sb-span={config.paper.dan}>
      <h1 class="sb-headline sb-headline--l">{entry?.data.title ?? ja.about}</h1>
      {Content && <Content />}
    </article>
  </main>
</Layout>
